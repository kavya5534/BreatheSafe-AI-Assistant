# ==========================================
# BreatheSafe AI - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values.
# Never commit your .env file to version control.

# --- Backend Server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
SQLITE_DB_PATH=breathesafe.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI Chatbot Provider Configuration ---
# Supported providers: openai_compatible, gemini
# For OpenAI, Groq, OpenRouter, Together, Ollama, or Gemini OpenAI-compat:
AI_PROVIDER=openai_compatible
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=30

# --- Air Quality & Weather Data Provider ---
# Default uses Open-Meteo (free, no API key required) with geocoding.
# Optional: configure WAQI_API_TOKEN or OPENWEATHER_API_KEY for alternate live sources.
AQI_PROVIDER=open_meteo
WAQI_API_TOKEN=
OPENWEATHER_API_KEY=
DEFAULT_CITY=Bengaluru
DEFAULT_LAT=12.9716
DEFAULT_LON=77.5946
